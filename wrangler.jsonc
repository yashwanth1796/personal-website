{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Static-assets-only Worker: Cloudflare serves the `next build` output from its CDN.
  // There is no Worker script, so requests use no compute and cost nothing on the free plan.
  "name": "portfolio",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./out",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  }
}
